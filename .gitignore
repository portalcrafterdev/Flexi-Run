# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Agent instructions. Notes to a coding assistant about how to build the game,
# not part of the game. Matched anywhere, which also catches the stray
# "CLAUDE (6).md" copy sitting in test/.
CLAUDE*.md

# Signing material. android/.gitignore already catches these inside android/,
# but a keystore left at the repo root would not be, and this is the one
# secret in the project that cannot be rotated after it leaks: whoever holds
# it can sign builds as us, forever.
key.properties
*.jks
*.keystore
*.p12

# Store upload bundles. Built by hand from tool/play_games/ and uploaded to
# Play Console; nothing reads them back.
/flexirun-*.zip

# Scratch output from the icon generators - contact sheets and the like.
/tool/_*

# Everything HTML under design/: both the ~2 MB seeded canvas and the .dc.html
# artboards it is built from.
#
# The artboards are the only copy of the design, so this does mean the design
# is not in git - it lives in the working tree and in the published canvas,
# which can be extracted back into artboards if they are ever needed again.
/design/*.html

# Gradle writes build output under android/ as well as at the repo root, and
# the stock Flutter ignore above only covers the root one - which is how
# android/build/reports/problems/problems-report.html ended up committed.
/android/build/
/android/app/build/
